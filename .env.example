# Formalogy OS — modèle de variables d'environnement
#
# Ce fichier est un MODÈLE, versionné dans Git. Il ne contient aucun secret.
# Copie-le en « .env » et remplis les valeurs réelles : le fichier .env, lui,
# n'est jamais envoyé sur Git.
#
# Les lignes vides sont normales : chaque bloc est rempli à la phase indiquée.

# ---------------------------------------------------------------------------
# Base de données — Supabase (Phase 2)
# Tableau de bord Supabase > Project Settings > Database > Connection string
# ---------------------------------------------------------------------------
# Connexion via le pooler, utilisée par l'application
DATABASE_URL=
# Connexion directe, utilisée uniquement pour les migrations Prisma
DIRECT_URL=

# ---------------------------------------------------------------------------
# Authentification — better-auth (Phase 2)
# Le secret signe les sessions. Se génère avec : openssl rand -base64 32
# Il doit être différent entre développement et production.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stockage des documents — Supabase Storage (Phase 8)
# Clé « service_role » : STRICTEMENT côté serveur, jamais dans le navigateur
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ---------------------------------------------------------------------------
# Emails — compte Gmail dédié (SMTP + mot de passe d'application)
# ---------------------------------------------------------------------------
# Nom affiché dans les emails ({{organisme.nom}})
ORGANISME_NOM=Formalogy
# Verrou de sécurité : tant que cette valeur n'est pas exactement « true »,
# aucun email ne part réellement — ils sont simulés et visibles dans l'historique.
EMAILS_ENVOI_REEL=false
# Adresse Gmail dédiée aux envois, ex. formalogy.formations@gmail.com
GMAIL_ADRESSE=
# Mot de passe d'application (16 lettres) créé dans le compte Google :
# Sécurité > Validation en deux étapes > Mots de passe des applications.
# Ce n'est PAS le mot de passe du compte.
GMAIL_MOT_DE_PASSE_APPLI=
# Nom affiché comme expéditeur (par défaut : ORGANISME_NOM)
GMAIL_NOM_EXPEDITEUR=

# ---------------------------------------------------------------------------
# Automatisations (Phase 9)
# Secret exigé par le réveil quotidien. Se génère avec : openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Signature électronique — BoldSign (Phase 11)
# Formule sans API : les documents sont envoyés depuis le site BoldSign, et
# les documents signés sont récupérés dans la boîte Gmail dédiée (voir Emails).
# Aucune clé BoldSign n'est nécessaire.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Facturation — Henrri (Phase 13)
# Laisser vide tant que les accès API ne sont pas disponibles :
# l'application utilisera alors un connecteur simulé, clairement identifié.
# ---------------------------------------------------------------------------
HENRRI_API_KEY=
HENRRI_API_BASE_URL=
