// Formalogy OS — schéma de base de données
//
// Depuis Prisma 7, les adresses de connexion ne vivent plus ici mais dans
// prisma.config.ts (migrations) et dans src/lib/prisma.ts (application).
//
// Les quatre tables d'authentification (user, session, account, verification)
// ont une structure imposée par better-auth : leurs champs ne doivent pas être
// renommés. Les champs propres à Formalogy y sont ajoutés en supplément et
// déclarés dans src/lib/auth.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles internes. Il n'existe volontairement pas de table de permissions
/// fines : l'outil est utilisé par 3 à 5 personnes, un rôle suffit.
/// Les apprenants ne sont PAS des utilisateurs : ils n'ont jamais de compte.
enum Role {
  /// Accès complet, y compris paramètres et gestion des utilisateurs
  ADMIN
  /// Accès administratif et commercial, sans les réglages système
  GESTIONNAIRE
  /// Accès restreint à ses propres sessions (écrans construits en Phase 10)
  FORMATEUR
}

/// Compte de connexion à l'application.
///
/// Le mot de passe n'est pas stocké ici mais dans Account.password, sous forme
/// d'empreinte — c'est le fonctionnement de better-auth.
///
/// Une fiche formateur (Phase 10) pourra pointer vers un utilisateur, mais tous
/// les formateurs n'ont pas de compte : les intervenants externes restent de
/// simples fiches.
model User {
  id String @id @default(uuid(7))

  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Le rôle est une énumération en base : une valeur inattendue est rejetée
  /// par PostgreSQL lui-même, pas seulement par le code.
  role Role @default(GESTIONNAIRE)

  /// Désactiver un compte plutôt que le supprimer conserve l'historique de ses
  /// actions dans le journal d'activité.
  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions   Session[]
  accounts   Account[]
  activities Activity[]

  entreprisesCreees Company[]  @relation("CompanyCreatedBy")
  contactsCrees     Contact[]  @relation("ContactCreatedBy")
  prospectsCrees    Prospect[] @relation("ProspectCreatedBy")
  prospectsSuivis   Prospect[] @relation("ProspectCommercial")
  apprenantsCrees   Learner[]  @relation("LearnerCreatedBy")
  formationsCreees  Formation[] @relation("FormationCreatedBy")

  @@index([deletedAt])
  @@map("user")
}

/// Sessions de connexion actives. Stockées en base — et donc révocables :
/// un administrateur peut déconnecter un compte à distance.
model Session {
  id String @id @default(uuid(7))

  token     String   @unique
  expiresAt DateTime

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Moyens d'authentification rattachés à un utilisateur.
/// Dans notre cas il n'y en a qu'un : email + mot de passe, dont l'empreinte
/// est stockée dans le champ `password`. La table prévoit aussi les connexions
/// via un service tiers, que nous n'utilisons pas.
model Account {
  id String @id @default(uuid(7))

  accountId  String
  providerId String

  /// Empreinte du mot de passe. Jamais le mot de passe en clair.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Jetons temporaires (réinitialisation de mot de passe, vérification d'email).
/// Table technique gérée par better-auth.
model Verification {
  id String @id @default(uuid(7))

  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// Journal d'activité global (cahier des charges, section 25).
/// Sert à la fois au fil « Dernières activités » du tableau de bord et à la
/// piste d'audit exigée par la section 29.
///
/// Les lignes ne sont jamais modifiées ni supprimées : c'est un journal.
/// L'auteur est conservé en lien souple — si un compte disparaît, la trace de
/// l'action subsiste.
model Activity {
  id String @id @default(uuid(7))

  /// Code technique stable, ex. « user.login », « invoice.sent »
  action String
  /// Phrase lisible affichée dans l'interface,
  /// ex. « Facture FA-2026-0142 envoyée à TechnoPlast SAS »
  summary String

  /// Objet concerné, pour retrouver l'historique d'une fiche.
  /// Volontairement non contraint : le journal doit pouvoir référencer
  /// n'importe quelle entité, y compris celles des phases futures.
  entityType String?
  entityId   String?

  /// Détails complémentaires (montants, statuts, identifiants externes)
  metadata Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("activities")
}

/// Étape du prospect dans le cycle commercial (cahier des charges, section 8).
enum StatutProspect {
  NOUVEAU
  A_CONTACTER
  CONTACTE
  RELANCE
  PROPOSITION_ENVOYEE
  NEGOCIATION
  GAGNE
  PERDU
}

/// Origine du prospect, pour savoir ce qui fait venir les clients.
enum SourceProspect {
  SITE_INTERNET
  CPF
  RECOMMANDATION
  PROSPECTION
  EMAIL
  TELEPHONE
  PARTENAIRE
  AUTRE
}

/// Entreprise cliente ou prospect.
///
/// Les entreprises ne sont jamais supprimées définitivement (deletedAt) :
/// elles restent rattachées à des factures et à des sessions, que les
/// obligations comptables imposent de conserver.
model Company {
  id String @id @default(uuid(7))

  raisonSociale String
  /// 14 chiffres. Non obligatoire : une entreprise peut être créée avant
  /// que l'on dispose de son SIRET.
  siret         String?
  adresse       String?
  codePostal    String?
  ville         String?
  telephone     String?
  email         String?
  siteWeb       String?
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  contacts  Contact[]
  prospects Prospect[]
  learners  Learner[]

  @@index([raisonSociale])
  @@index([deletedAt])
  @@map("companies")
}

/// Personne physique rattachée à une entreprise.
model Contact {
  id String @id @default(uuid(7))

  prenom    String
  nom       String
  fonction  String?
  email     String?
  telephone String?
  notes     String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([deletedAt])
  @@map("contacts")
}

/// Piste commerciale suivie dans le CRM.
///
/// Un prospect peut exister avant son entreprise : le nom de l'entreprise
/// est alors saisi en texte libre, et le rattachement se fait plus tard.
model Prospect {
  id String @id @default(uuid(7))

  prenom    String
  nom       String
  email     String?
  telephone String?

  /// Entreprise déjà enregistrée, si elle existe
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Sinon, nom saisi tel quel
  entreprise String?

  source SourceProspect @default(AUTRE)
  statut StatutProspect @default(NOUVEAU)

  /// Montant estimé en euros
  montantPotentiel Decimal? @db.Decimal(10, 2)

  derniereInteractionAt DateTime?
  prochaineRelanceAt    DateTime?
  notes                 String?

  /// Commercial en charge du suivi
  commercialId String?
  commercial   User?   @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ProspectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([statut])
  @@index([prochaineRelanceAt])
  @@index([companyId])
  @@index([deletedAt])
  @@map("prospects")
}

/// Qui paie la formation. Détermine les pièces à réunir et le circuit
/// de facturation (Phases 13 et 14).
enum TypeFinancement {
  ENTREPRISE
  OPCO
  CPF
  FRANCE_TRAVAIL
  PERSONNEL
  AUTRE
}

/// Où en est l'apprenant dans son parcours.
enum StatutApprenant {
  PROSPECT
  INSCRIT
  EN_FORMATION
  TERMINE
  ABANDONNE
}

/// Apprenant.
///
/// N'est JAMAIS un utilisateur de l'application : aucun compte, aucune
/// connexion. Il reçoit des emails et signe ses documents depuis le portail
/// Yousign, rien de plus.
///
/// Contient des données personnelles (identité, date de naissance, adresse) :
/// la suppression est douce, et l'export comme l'effacement définitif devront
/// être possibles depuis l'application (RGPD).
model Learner {
  id String @id @default(uuid(7))

  prenom        String
  nom           String
  dateNaissance DateTime?
  email         String?
  telephone     String?

  adresse    String?
  codePostal String?
  ville      String?

  /// Entreprise qui inscrit l'apprenant. Absente pour un particulier
  /// finançant lui-même sa formation (CPF, financement personnel).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  statut      StatutApprenant @default(INSCRIT)
  financement TypeFinancement @default(ENTREPRISE)

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("LearnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([nom, prenom])
  @@index([companyId])
  @@index([statut])
  @@index([deletedAt])
  @@map("learners")
}

/// Comment la formation est dispensée (cahier des charges, section 11).
enum ModaliteFormation {
  PRESENTIEL
  DISTANCIEL
  E_LEARNING
  HYBRIDE
}

/// Une formation en brouillon n'apparaît pas dans les choix de session ;
/// une formation archivée reste consultable pour l'historique.
enum StatutFormation {
  BROUILLON
  ACTIVE
  ARCHIVEE
}

/// Catégorie du catalogue. Table plutôt qu'énumération : la liste pourra
/// s'enrichir depuis les Paramètres sans modifier le code.
model FormationCategory {
  id    String @id @default(uuid(7))
  nom   String @unique
  ordre Int    @default(0)

  formations Formation[]

  @@map("formation_categories")
}

/// Formation du catalogue.
///
/// Elle décrit l'offre (programme, durée, prix) ; une session en est la
/// réalisation concrète à des dates données (Phase 7). Modifier le prix d'une
/// formation ne doit jamais modifier une session ou une facture passée : ces
/// montants seront recopiés au moment de leur création.
model Formation {
  id String @id @default(uuid(7))

  titre     String
  /// Code interne unique, ex. « BUR-EXC-02 »
  reference String @unique

  categoryId String?
  category   FormationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description  String?
  objectifs    String?
  programme    String?
  prerequis    String?
  publicVise   String?
  competences  String?
  /// Certification visée (RS, RNCP, TOSA…), le cas échéant
  certification String?

  dureeHeures Decimal? @db.Decimal(6, 2)
  dureeJours  Decimal? @db.Decimal(4, 1)
  /// Prix de référence hors taxes, en euros
  prixHT      Decimal? @db.Decimal(10, 2)

  modalite ModaliteFormation @default(PRESENTIEL)
  statut   StatutFormation   @default(BROUILLON)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("FormationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([statut])
  @@index([deletedAt])
  @@map("formations")
}
