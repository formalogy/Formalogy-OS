// Formalogy OS — schéma de base de données
//
// Depuis Prisma 7, les adresses de connexion ne vivent plus ici mais dans
// prisma.config.ts (migrations) et dans src/lib/prisma.ts (application).
//
// Les quatre tables d'authentification (user, session, account, verification)
// ont une structure imposée par better-auth : leurs champs ne doivent pas être
// renommés. Les champs propres à Formalogy y sont ajoutés en supplément et
// déclarés dans src/lib/auth.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles internes. Il n'existe volontairement pas de table de permissions
/// fines : l'outil est utilisé par 3 à 5 personnes, un rôle suffit.
/// Les apprenants ne sont PAS des utilisateurs : ils n'ont jamais de compte.
enum Role {
  /// Accès complet, y compris paramètres et gestion des utilisateurs
  ADMIN
  /// Accès administratif et commercial, sans les réglages système
  GESTIONNAIRE
  /// Accès restreint à ses propres sessions, en lecture (espace « Mes sessions »)
  FORMATEUR
}

/// Compte de connexion à l'application.
///
/// Le mot de passe n'est pas stocké ici mais dans Account.password, sous forme
/// d'empreinte — c'est le fonctionnement de better-auth.
///
/// Une fiche formateur peut pointer vers un utilisateur, mais tous les
/// formateurs n'ont pas de compte : les intervenants occasionnels restent de
/// simples fiches.
model User {
  id String @id @default(uuid(7))

  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Le rôle est une énumération en base : une valeur inattendue est rejetée
  /// par PostgreSQL lui-même, pas seulement par le code.
  role Role @default(GESTIONNAIRE)

  /// Désactiver un compte plutôt que le supprimer conserve l'historique de ses
  /// actions dans le journal d'activité.
  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions   Session[]
  accounts   Account[]
  activities Activity[]

  entreprisesCreees Company[]  @relation("CompanyCreatedBy")
  contactsCrees     Contact[]  @relation("ContactCreatedBy")
  prospectsCrees    Prospect[] @relation("ProspectCreatedBy")
  prospectsSuivis   Prospect[] @relation("ProspectCommercial")
  apprenantsCrees   Learner[]  @relation("LearnerCreatedBy")
  formationsCreees  Formation[] @relation("FormationCreatedBy")
  sessionsCreees    TrainingSession[] @relation("SessionCreatedBy")
  documentsCrees    Document[] @relation("DocumentCreatedBy")
  versionsDeposees  DocumentVersion[] @relation("DocumentVersionCreatedBy")
  emailsEnvoyes     Email[] @relation("EmailCreatedBy")
  tachesCreees      Task[] @relation("TaskCreatedBy")
  formateursCrees   Trainer[] @relation("TrainerCreatedBy")
  signaturesCreees  SignatureRequest[] @relation("SignatureCreatedBy")
  presencesSaisies  Presence[] @relation("PresenceSaisiePar")
  evaluationsSaisies EvaluationAcquis[] @relation("EvaluationSaisiePar")
  facturesCreees     Facture[]  @relation("FactureCreatedBy")
  dossiersCrees      DossierFinancement[] @relation("DossierCreatedBy")
  indicateursSuivis  IndicateurQualiopi[] @relation("IndicateurUpdatedBy")
  actionsQualiteCreees ActionQualite[]    @relation("ActionQualiteCreatedBy")
  paiementsSaisis    Paiement[] @relation("PaiementCreatedBy")

  /// Fiche formateur liée, pour un compte de rôle FORMATEUR
  formateur Trainer? @relation("TrainerUser")

  @@index([deletedAt])
  @@map("user")
}

/// Sessions de connexion actives. Stockées en base — et donc révocables :
/// un administrateur peut déconnecter un compte à distance.
model Session {
  id String @id @default(uuid(7))

  token     String   @unique
  expiresAt DateTime

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Moyens d'authentification rattachés à un utilisateur.
/// Dans notre cas il n'y en a qu'un : email + mot de passe, dont l'empreinte
/// est stockée dans le champ `password`. La table prévoit aussi les connexions
/// via un service tiers, que nous n'utilisons pas.
model Account {
  id String @id @default(uuid(7))

  accountId  String
  providerId String

  /// Empreinte du mot de passe. Jamais le mot de passe en clair.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Jetons temporaires (réinitialisation de mot de passe, vérification d'email).
/// Table technique gérée par better-auth.
model Verification {
  id String @id @default(uuid(7))

  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

/// Journal d'activité global (cahier des charges, section 25).
/// Sert à la fois au fil « Dernières activités » du tableau de bord et à la
/// piste d'audit exigée par la section 29.
///
/// Les lignes ne sont jamais modifiées ni supprimées : c'est un journal.
/// L'auteur est conservé en lien souple — si un compte disparaît, la trace de
/// l'action subsiste.
model Activity {
  id String @id @default(uuid(7))

  /// Code technique stable, ex. « user.login », « invoice.sent »
  action String
  /// Phrase lisible affichée dans l'interface,
  /// ex. « Facture FA-2026-0142 envoyée à TechnoPlast SAS »
  summary String

  /// Objet concerné, pour retrouver l'historique d'une fiche.
  /// Volontairement non contraint : le journal doit pouvoir référencer
  /// n'importe quelle entité, y compris celles des phases futures.
  entityType String?
  entityId   String?

  /// Détails complémentaires (montants, statuts, identifiants externes)
  metadata Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("activities")
}

/// Étape du prospect dans le cycle commercial (cahier des charges, section 8).
enum StatutProspect {
  NOUVEAU
  A_CONTACTER
  CONTACTE
  RELANCE
  PROPOSITION_ENVOYEE
  NEGOCIATION
  GAGNE
  PERDU
}

/// Origine du prospect, pour savoir ce qui fait venir les clients.
enum SourceProspect {
  SITE_INTERNET
  CPF
  RECOMMANDATION
  PROSPECTION
  EMAIL
  TELEPHONE
  PARTENAIRE
  AUTRE
}

/// Entreprise cliente ou prospect.
///
/// Les entreprises ne sont jamais supprimées définitivement (deletedAt) :
/// elles restent rattachées à des factures et à des sessions, que les
/// obligations comptables imposent de conserver.
model Company {
  id String @id @default(uuid(7))

  raisonSociale String
  /// 14 chiffres. Non obligatoire : une entreprise peut être créée avant
  /// que l'on dispose de son SIRET.
  siret         String?
  adresse       String?
  codePostal    String?
  ville         String?
  telephone     String?
  email         String?
  siteWeb       String?
  notes         String?

  /// Identifiant du client correspondant chez Henrri, une fois créé : évite
  /// de recréer un doublon à chaque facture.
  henrriCustomerId Int? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  contacts  Contact[]
  prospects Prospect[]
  learners  Learner[]
  sessions  TrainingSession[]
  documents Document[]
  emails    Email[]
  taches    Task[]

  factures Facture[]
  dossiers DossierFinancement[]

  @@index([raisonSociale])
  @@index([deletedAt])
  @@map("companies")
}

/// Personne physique rattachée à une entreprise.
model Contact {
  id String @id @default(uuid(7))

  prenom    String
  nom       String
  fonction  String?
  email     String?
  telephone String?
  notes     String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([deletedAt])
  @@map("contacts")
}

/// Piste commerciale suivie dans le CRM.
///
/// Un prospect peut exister avant son entreprise : le nom de l'entreprise
/// est alors saisi en texte libre, et le rattachement se fait plus tard.
model Prospect {
  id String @id @default(uuid(7))

  prenom    String
  nom       String
  email     String?
  telephone String?

  /// Entreprise déjà enregistrée, si elle existe
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Sinon, nom saisi tel quel
  entreprise String?

  source SourceProspect @default(AUTRE)
  statut StatutProspect @default(NOUVEAU)

  /// Montant estimé en euros
  montantPotentiel Decimal? @db.Decimal(10, 2)

  derniereInteractionAt DateTime?
  prochaineRelanceAt    DateTime?
  notes                 String?

  /// Commercial en charge du suivi
  commercialId String?
  commercial   User?   @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ProspectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  emails Email[]
  taches Task[]

  @@index([statut])
  @@index([prochaineRelanceAt])
  @@index([companyId])
  @@index([deletedAt])
  @@map("prospects")
}

/// Qui paie la formation. Détermine les pièces à réunir et le circuit
/// de facturation (Phases 13 et 14).
enum TypeFinancement {
  ENTREPRISE
  OPCO
  CPF
  FRANCE_TRAVAIL
  PERSONNEL
  AUTRE
}

/// Où en est l'apprenant dans son parcours.
enum StatutApprenant {
  PROSPECT
  INSCRIT
  EN_FORMATION
  TERMINE
  ABANDONNE
}

/// Apprenant.
///
/// N'est JAMAIS un utilisateur de l'application : aucun compte, aucune
/// connexion. Il reçoit des emails et signe ses documents depuis le portail
/// Yousign, rien de plus.
///
/// Contient des données personnelles (identité, date de naissance, adresse) :
/// la suppression est douce, et l'export comme l'effacement définitif devront
/// être possibles depuis l'application (RGPD).
model Learner {
  id String @id @default(uuid(7))

  prenom        String
  nom           String
  dateNaissance DateTime?
  email         String?
  telephone     String?

  adresse    String?
  codePostal String?
  ville      String?

  /// Niveau d'études ou diplôme le plus élevé (texte libre, ex. « Bac+3 —
  /// licence de gestion »).
  niveauEtudes String?

  /// Emplacement de la photo de profil dans le stockage (bucket "documents",
  /// chemin "apprenants/<id>/…"), remplacée entièrement à chaque nouvel envoi.
  photoCheminStockage String?

  /// Entreprise qui inscrit l'apprenant. Absente pour un particulier
  /// finançant lui-même sa formation (CPF, financement personnel).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  statut      StatutApprenant @default(INSCRIT)
  financement TypeFinancement @default(ENTREPRISE)

  /// Numéro du dossier CPF (moncompteformation.gouv.fr), pour un financement
  /// personnel via le compte personnel de formation.
  /// Avec l'identité de l'apprenant, il figure sur la facture adressée à la
  /// Caisse des Dépôts.
  numeroDossierCpf String?

  notes String?

  /// Identifiant du client correspondant chez Henrri, une fois créé : évite
  /// de recréer un doublon à chaque facture.
  henrriCustomerId Int? @unique

  /// Droit à l'effacement (RGPD) exercé : identité et coordonnées remplacées,
  /// fiche masquée. Les enregistrements liés (sessions, évaluations, factures)
  /// sont conservés sans donnée personnelle, pour la durée légale de
  /// conservation (comptabilité, traçabilité Qualiopi).
  anonymiseAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("LearnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  inscriptions SessionLearner[]
  documents    Document[]
  presences    Presence[]
  evaluations  EvaluationAcquis[]
  satisfactions QuestionnaireSatisfaction[]
  questionnaires Questionnaire[]
  factures     Facture[]
  dossiers     DossierFinancement[]

  emails Email[]
  taches Task[]

  @@index([nom, prenom])
  @@index([companyId])
  @@index([statut])
  @@index([deletedAt])
  @@map("learners")
}

/// Comment la formation est dispensée (cahier des charges, section 11).
enum ModaliteFormation {
  PRESENTIEL
  DISTANCIEL
  E_LEARNING
  HYBRIDE
}

/// Une formation en brouillon n'apparaît pas dans les choix de session ;
/// une formation archivée reste consultable pour l'historique.
enum StatutFormation {
  BROUILLON
  ACTIVE
  ARCHIVEE
}

/// Catégorie du catalogue. Table plutôt qu'énumération : la liste pourra
/// s'enrichir depuis les Paramètres sans modifier le code.
model FormationCategory {
  id    String @id @default(uuid(7))
  nom   String @unique
  ordre Int    @default(0)

  formations Formation[]

  @@map("formation_categories")
}

/// Formation du catalogue.
///
/// Elle décrit l'offre (programme, durée, prix) ; une session en est la
/// réalisation concrète à des dates données (Phase 7). Modifier le prix d'une
/// formation ne doit jamais modifier une session ou une facture passée : ces
/// montants seront recopiés au moment de leur création.
model Formation {
  id String @id @default(uuid(7))

  titre     String
  /// Code interne unique, ex. « BUR-EXC-02 »
  reference String @unique

  categoryId String?
  category   FormationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description  String?
  objectifs    String?
  programme    String?
  prerequis    String?
  publicVise   String?
  competences  String?
  /// Certification visée (RS, RNCP, TOSA…), le cas échéant
  certification String?

  dureeHeures Decimal? @db.Decimal(6, 2)
  dureeJours  Decimal? @db.Decimal(4, 1)
  /// Prix de référence hors taxes, en euros
  prixHT      Decimal? @db.Decimal(10, 2)

  modalite ModaliteFormation @default(PRESENTIEL)
  statut   StatutFormation   @default(BROUILLON)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("FormationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sessions  TrainingSession[]
  documents Document[]

  @@index([categoryId])
  @@index([statut])
  @@index([deletedAt])
  @@map("formations")
}

/// Cycle de vie d'une session (cahier des charges, section 12).
enum StatutSession {
  BROUILLON
  A_PREPARER
  DOCUMENTS_EN_ATTENTE
  PRETE
  EN_COURS
  TERMINEE
  CLOTUREE
  ANNULEE
}

/// Session de formation : la réalisation concrète d'une formation du
/// catalogue, à des dates données, pour des apprenants donnés.
///
/// Nommée TrainingSession dans le code pour ne pas la confondre avec les
/// sessions de connexion (modèle Session) ; la table s'appelle « sessions ».
model TrainingSession {
  id String @id @default(uuid(7))

  /// Numéro lisible, unique, ex. « S-2026-0007 »
  numero String @unique

  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Restrict)

  /// Entreprise cliente pour une session intra-entreprise. Absente pour une
  /// session inter-entreprises ou des particuliers.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Dates stockées à minuit UTC : ce sont des jours calendaires, pas des
  /// instants. Tous les calculs de planning se font en UTC.
  dateDebut DateTime
  dateFin   DateTime
  /// Ex. « 9h00–12h30 / 13h30–17h00 »
  horaires  String?
  lieu      String?

  modalite ModaliteFormation
  statut   StatutSession     @default(BROUILLON)

  /// Alerte du client : tant qu'elle est posée, plus rien ne part pour cette
  /// session (envois, documents, changement de statut, facture). Le
  /// déroulement reprend là où il en est dès qu'elle est levée.
  deroulementSuspenduAt DateTime?

  /// Formateur principal de la session
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  placesMax   Int?

  /// Prix HT recopié depuis la formation à la création : modifier le
  /// catalogue ensuite ne change pas le prix de cette session.
  prixHT Decimal? @db.Decimal(10, 2)

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  inscriptions SessionLearner[]
  documents    Document[]
  presences    Presence[]
  evaluations  EvaluationAcquis[]
  satisfactions QuestionnaireSatisfaction[]
  questionnaires Questionnaire[]
  factures     Facture[]
  dossiers     DossierFinancement[]

  emails Email[]
  taches Task[]

  @@index([dateDebut, dateFin])
  @@index([statut])
  @@index([formationId])
  @@index([companyId])
  @@index([trainerId])
  @@index([deletedAt])
  @@map("sessions")
}

/// Inscription d'un apprenant à une session.
model SessionLearner {
  id String @id @default(uuid(7))

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  learnerId String
  learner   Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  /// Tarif HT de cet apprenant pour cette session, indiqué à l'inscription
  /// (pré-rempli avec le prix de la session). C'est le montant de sa facture
  /// personnelle (dossier CPF, apprenant qui paie lui-même).
  prixHT Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([sessionId, learnerId])
  @@index([learnerId])
  @@map("session_learners")
}

/// Catégories de la bibliothèque documentaire (cahier des charges, section 15).
enum CategorieDocument {
  APPRENANT
  ENTREPRISE
  SESSION
  FORMATEUR
  FORMATION
  FINANCE
  QUALIOPI
}

enum StatutDocument {
  BROUILLON
  VALIDE
  ARCHIVE
}

/// Nature d'un document (convention, programme, attestation…).
/// Table plutôt qu'énumération : la liste s'enrichira depuis les Paramètres.
/// Certains types sont reconnus par le code (liste de contrôle d'une session,
/// documents manquants) grâce à leur `code`, stable, et non à leur nom.
model DocumentType {
  id        String            @id @default(uuid(7))
  code      String            @unique
  nom       String            @unique
  categorie CategorieDocument
  ordre     Int               @default(0)

  documents Document[]

  @@map("document_types")
}

/// Document de la bibliothèque.
///
/// Le fichier lui-même n'est pas ici mais dans ses versions : remplacer un
/// document crée une nouvelle version, sans effacer la précédente.
/// Un document peut être rattaché à une fiche (apprenant, entreprise, session,
/// formation) ou n'être rattaché à rien (document Qualiopi général, par exemple).
model Document {
  id String @id @default(uuid(7))

  nom         String
  description String?

  typeId String?
  type   DocumentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  categorie CategorieDocument
  statut    StatutDocument    @default(VALIDE)

  learnerId   String?
  learner     Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessionId   String?
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  formationId String?
  formation   Formation?       @relation(fields: [formationId], references: [id], onDelete: SetNull)
  trainerId   String?
  trainer     Trainer?         @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  /// Preuve rattachée à un indicateur Qualiopi
  indicateurQualiopi Int?
  indicateur         IndicateurQualiopi? @relation(fields: [indicateurQualiopi], references: [numero], onDelete: SetNull)

  versions   DocumentVersion[]
  signatures SignatureRequest[]
  factures   Facture[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Suppression douce : le document disparaît de l'interface, ses fichiers
  /// sont conservés (traçabilité Qualiopi). L'effacement définitif relèvera
  /// des outils RGPD (Phase 17).
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categorie])
  @@index([typeId])
  @@index([learnerId])
  @@index([companyId])
  @@index([sessionId])
  @@index([formationId])
  @@index([trainerId])
  @@index([indicateurQualiopi])
  @@index([deletedAt])
  @@map("documents")
}

/// Version d'un fichier. Les versions ne sont jamais modifiées : c'est
/// l'historique du document.
model DocumentVersion {
  id String @id @default(uuid(7))

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  numero Int

  /// Emplacement dans l'espace de stockage. Généré par le serveur, jamais
  /// dérivé du nom de fichier fourni par l'utilisateur.
  cheminStockage String @unique
  nomFichier     String
  typeMime       String
  /// En octets
  taille         Int
  /// Empreinte SHA-256 : permet de prouver qu'un fichier n'a pas été altéré.
  empreinte      String

  commentaire String?

  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Demande de signature dont cette version est le fichier envoyé…
  signaturesEnvoyees SignatureRequest[] @relation("SignatureVersionSource")
  /// …ou le résultat signé
  signatureObtenue   SignatureRequest?  @relation("SignatureVersionSignee")

  @@unique([documentId, numero])
  @@map("document_versions")
}

// ===========================================================================
// Emails, tâches et automatisations (Phase 9)
// ===========================================================================

/// SIMULE : l'envoi réel est désactivé, le message n'a pas quitté l'application.
/// DELIVRE et OUVERT sont inutilisés avec Gmail (pas de suivi) ; conservés pour
/// un éventuel prestataire qui saurait les détecter.
enum StatutEmail {
  SIMULE
  ENVOYE
  DELIVRE
  OUVERT
  ECHEC
}

/// Modèle d'email avec variables, ex. « Bonjour {{apprenant.prenom}} ».
/// Le `code` est stable : les automatisations désignent un modèle par son code.
model EmailTemplate {
  id          String  @id @default(uuid(7))
  code        String  @unique
  nom         String
  description String?
  sujet       String
  corps       String
  actif       Boolean @default(true)

  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

/// Historique : chaque email envoyé (ou simulé) est conservé tel qu'il a été
/// rendu, variables remplacées. Modifier un modèle ne réécrit pas le passé.
model Email {
  id String @id @default(uuid(7))

  destinataire String
  sujet        String
  corps        String

  statut StatutEmail
  /// Identifiant chez le prestataire, pour rapprocher ses notifications
  fournisseurId String? @unique
  erreur        String?

  envoyeAt  DateTime  @default(now())
  delivreAt DateTime?
  ouvertAt  DateTime?

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  learnerId  String?
  learner    Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessionId  String?
  session    TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  prospectId String?
  prospect   Prospect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  automationRunId String?
  automationRun   AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("EmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([envoyeAt])
  @@index([learnerId])
  @@index([sessionId])
  @@index([statut])
  @@map("emails")
}

enum StatutTache {
  A_FAIRE
  FAITE
}

enum PrioriteTache {
  BASSE
  NORMALE
  HAUTE
}

/// Tâche à traiter (relance, dossier à compléter, préparation de facture…),
/// créée à la main ou par une automatisation.
model Task {
  id String @id @default(uuid(7))

  titre       String
  description String?
  echeance    DateTime?
  statut      StatutTache   @default(A_FAIRE)
  priorite    PrioriteTache @default(NORMALE)
  faiteAt     DateTime?

  learnerId  String?
  learner    Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessionId  String?
  session    TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  prospectId String?
  prospect   Prospect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  automationRunId String?
  automationRun   AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([statut, echeance])
  @@map("tasks")
}

/// Événements qui déclenchent une automatisation (cahier des charges, section 24).
/// Les déclencheurs liés aux factures et aux signatures arriveront avec leurs
/// phases (13 et 11).
enum DeclencheurAutomatisation {
  APPRENANT_CREE
  INSCRIPTION_SESSION
  SESSION_AVANT_DEBUT
  /// Quelques jours avant la fin d'une session (0 = le dernier jour)
  SESSION_AVANT_FIN
  /// Quelques jours après la fin d'une session
  SESSION_APRES_FIN
  SESSION_TERMINEE
  /// Chaque jour de la session, du premier au dernier (feuille d'émargement du jour)
  SESSION_JOUR
  RELANCE_PROSPECT_DUE
  /// Campagne annuelle à date fixe (jour et mois en paramètres), sans lien
  /// avec une session : questionnaires annuels aux formateurs et financeurs.
  CAMPAGNE_ANNUELLE
}

/// Règle DÉCLENCHEUR → CONDITION → ACTION.
///
/// `parametres` précise le déclencheur (ex. nombre de jours avant la session),
/// `conditions` filtre les cas concernés, `actions` décrit ce qui est fait.
/// Leur forme est validée par le moteur (lib/automatisations), pas par la base.
model Automation {
  id          String                    @id @default(uuid(7))
  nom         String
  description String?
  declencheur DeclencheurAutomatisation
  parametres  Json                      @default("{}")
  conditions  Json                      @default("{}")
  actions     Json
  actif       Boolean                   @default(false)

  /// Date de la dernière activation. Elle borne les déclencheurs « après la
  /// fin », seuls à n'avoir aucune limite dans le passé : sans elle, activer
  /// une automatisation après avoir importé un historique déclencherait une
  /// rafale d'envois sur des sessions terminées depuis des mois.
  activeeAt DateTime?

  executions AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automations")
}

enum StatutExecution {
  REUSSIE
  IGNOREE
  ECHEC
}

/// Trace de chaque exécution. La clé d'unicité garantit qu'une même
/// automatisation ne traite jamais deux fois le même cas : un apprenant ne
/// reçoit pas deux fois son email de bienvenue, même si le réveil quotidien
/// tourne deux fois.
model AutomationRun {
  id String @id @default(uuid(7))

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  cleUnicite String          @unique
  entityType String
  entityId   String
  statut     StatutExecution
  detail     String?

  emails Email[]
  taches Task[]

  createdAt DateTime @default(now())

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

// ===========================================================================
// Formateurs (Phase 10)
// ===========================================================================

enum StatutFormateur {
  /// Formateur indépendant (facture ses prestations)
  INDEPENDANT
  /// Salarié de l'organisme
  SALARIE
  /// Intervenant d'un organisme sous-traitant
  SOUS_TRAITANT
}

/// Fiche formateur. Existe indépendamment de tout compte : un formateur n'a
/// accès à l'application que si un administrateur lui ouvre un accès, auquel
/// cas `userId` pointe vers un utilisateur de rôle FORMATEUR.
model Trainer {
  id String @id @default(uuid(7))

  prenom    String
  nom       String
  email     String?
  telephone String?

  statut StatutFormateur @default(INDEPENDANT)
  siret  String?
  /// Numéro de déclaration d'activité (NDA), pour un formateur indépendant ou
  /// sous-traitant lui-même organisme de formation déclaré.
  numeroDeclaration String?

  /// Domaines d'intervention, en texte libre (ex. « Excel, Power BI »)
  specialites String?
  /// Taux de commissionnement (%), information interne jamais montrée au formateur
  tauxCommissionnement Decimal? @db.Decimal(5, 2)

  notes String?
  actif Boolean @default(true)

  userId String? @unique
  user   User?   @relation("TrainerUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("TrainerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sessions  TrainingSession[]
  documents Document[]
  questionnaires Questionnaire[]

  @@index([nom, prenom])
  @@index([deletedAt])
  @@map("trainers")
}

// ===========================================================================
// Signatures électroniques (Phase 11)
// ===========================================================================

/// La formule BoldSign retenue n'a pas d'API : l'envoi se fait depuis le site
/// BoldSign, avec la référence de la demande dans le titre. Le document signé
/// revient par email dans la boîte Gmail dédiée, où l'application le récupère
/// grâce à cette référence. Un dépôt manuel reste toujours possible.
enum StatutSignature {
  /// Référence créée, document pas encore envoyé depuis BoldSign
  A_ENVOYER
  /// Envoyé aux signataires, en attente du document signé
  ENVOYEE
  /// Document signé récupéré et enregistré
  SIGNEE
  ANNULEE
}

enum OrigineSignature {
  /// Récupéré automatiquement depuis l'email de fin de signature
  EMAIL
  /// Déposé à la main
  MANUEL
}

model SignatureRequest {
  id String @id @default(uuid(7))

  /// Référence à reporter dans le titre BoldSign, ex. « SIG-2026-0007 »
  reference String @unique

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  /// Version exacte envoyée à la signature
  versionSourceId String
  versionSource   DocumentVersion @relation("SignatureVersionSource", fields: [versionSourceId], references: [id], onDelete: Restrict)

  statut StatutSignature @default(A_ENVOYER)

  /// Signataires attendus : [{ nom, email }]. Informatif : c'est BoldSign qui
  /// fait foi sur qui a signé (voir la preuve de signature).
  signataires Json

  envoyeeAt DateTime?
  signeeAt  DateTime?
  annuleeAt DateTime?

  /// Version du document créée à partir du fichier signé
  versionSigneeId String?          @unique
  versionSignee   DocumentVersion? @relation("SignatureVersionSignee", fields: [versionSigneeId], references: [id], onDelete: SetNull)
  origine         OrigineSignature?

  /// Preuve de signature (journal d'audit BoldSign), stockée à part
  preuveChemin     String? @unique
  preuveNomFichier String?
  preuveTaille     Int?
  preuveEmpreinte  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("SignatureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([statut])
  @@index([documentId])
  @@map("signature_requests")
}

/// Emails déjà examinés dans la boîte dédiée : un même email n'est jamais
/// traité deux fois, et tout ce qui n'a pas pu être rapproché reste visible.
enum ResultatEmailEntrant {
  RAPPROCHE
  IGNORE
  A_VERIFIER
}

model EmailEntrant {
  id String @id @default(uuid(7))

  /// En-tête Message-ID : identifiant unique de l'email
  messageId String @unique
  expediteur String
  sujet      String
  recuAt     DateTime

  resultat ResultatEmailEntrant
  motif    String?

  signatureRequestId String?

  createdAt DateTime @default(now())

  @@index([resultat])
  @@map("emails_entrants")
}

// ===========================================================================
// Émargement et présences (Phase 11)
// ===========================================================================

enum Creneau {
  MATIN
  APRES_MIDI
}

enum StatutPresence {
  PRESENT
  ABSENT
  /// Absence justifiée (arrêt maladie, convocation…)
  ABSENT_JUSTIFIE
}

/// Présence d'un apprenant sur une demi-journée de session.
///
/// Saisie par l'équipe ou par le formateur de la session. Elle ne remplace pas
/// la feuille d'émargement signée, qui reste la preuve déposée dans les
/// documents ; elle sert au suivi, aux attestations et aux financeurs.
model Presence {
  id String @id @default(uuid(7))

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  /// Jour calendaire, à minuit UTC comme les dates de session
  jour    DateTime
  creneau Creneau
  statut  StatutPresence

  saisieParId String?
  saisiePar   User?   @relation("PresenceSaisiePar", fields: [saisieParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, learnerId, jour, creneau])
  @@index([learnerId])
  @@map("presences")
}

// ===========================================================================
// Organisme, fin de formation et évaluations (Phase 12)
// ===========================================================================

/// Informations légales de l'organisme, reprises sur les attestations et
/// certificats. Une seule ligne, d'identifiant fixe « organisme ».
model Organisme {
  id String @id @default("organisme")

  raisonSociale String
  siret         String?
  /// Numéro de déclaration d'activité (NDA) attribué par la DREETS
  numeroDeclaration String?
  adresse    String?
  codePostal String?
  ville      String?
  telephone  String?
  email      String?
  siteWeb    String?

  /// Signataire des attestations, ex. « Jimmy Struzyk », « Dirigeant »
  representantNom      String?
  representantFonction String?

  /// Référents nommés sur la convocation. Le référent handicap est une
  /// exigence Qualiopi (indicateur 26) ; les deux autres répondent aux
  /// questions pratiques de l'apprenant avant la formation.
  referentHandicapNom       String?
  referentHandicapEmail     String?
  referentHandicapTelephone String?
  referentAdministratifNom       String?
  referentAdministratifEmail     String?
  referentAdministratifTelephone String?
  referentRgpdNom   String?
  referentRgpdEmail String?

  /// Signature (ou cachet signé) de l'organisme, apposée au bas des documents
  /// qu'il émet. Image stockée comme les autres fichiers, jamais en base.
  signatureCheminStockage String?

  /// Logo repris en tête des documents générés.
  logoCheminStockage String?

  /// Certification Qualiopi : organisme certificateur et échéances
  qualiopiCertificateur  String?
  qualiopiObtentionAt    DateTime?
  qualiopiExpireAt       DateTime?
  qualiopiProchainAuditAt DateTime?

  /// Client « Caisse des Dépôts » chez Henrri, créé une fois pour toutes :
  /// destinataire des factures des dossiers CPF.
  henrriCaisseDepotsId Int?

  updatedAt DateTime @updatedAt

  @@map("organisme")
}

enum ResultatAcquis {
  ACQUIS
  PARTIELLEMENT_ACQUIS
  NON_ACQUIS
}

/// Résultat de l'évaluation des acquis d'un apprenant à l'issue d'une session,
/// reporté sur l'attestation de fin de formation (article L6353-1).
model EvaluationAcquis {
  id String @id @default(uuid(7))

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  resultat    ResultatAcquis
  commentaire String?

  saisieParId String?
  saisiePar   User?   @relation("EvaluationSaisiePar", fields: [saisieParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, learnerId])
  @@map("evaluations_acquis")
}

/// Questionnaire de satisfaction « à chaud », rempli par l'apprenant depuis un
/// lien personnel. Seule l'empreinte du jeton est conservée : une fuite de la
/// base ne permet pas de répondre à la place des apprenants.
model QuestionnaireSatisfaction {
  id String @id @default(uuid(7))

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  /// Empreinte SHA-256 du jeton contenu dans le lien
  jetonEmpreinte String   @unique
  expireAt       DateTime

  envoyeAt  DateTime?
  reponduAt DateTime?

  /// Réponses par identifiant de question (voir lib/questionnaires-questions.ts)
  reponses   Json?
  /// Questions telles qu'elles ont été posées, figées à la réponse : modifier
  /// le questionnaire ensuite ne change pas le sens des réponses déjà reçues.
  questions  Json?
  noteGlobale Int?

  createdAt DateTime @default(now())

  @@unique([sessionId, learnerId])
  @@index([reponduAt])
  @@map("questionnaires_satisfaction")
}

/// Questionnaires « qualité », distincts du questionnaire de satisfaction
/// apprenant ci-dessus (QuestionnaireSatisfaction, envoyé à chaud à la fin
/// d'une session) : chacun s'adresse à un destinataire différent, avec ses
/// propres questions (cases à cocher et commentaires), définies en code dans
/// lib/questionnaires.ts plutôt qu'éditables depuis l'écran, pour que les
/// réponses restent comparables d'un envoi à l'autre (même logique que les
/// indicateurs Qualiopi).
enum TypeQuestionnaire {
  /// Attentes et positionnement de l'apprenant, avant la formation
  POSITIONNEMENT
  /// Ressenti du formateur à la fin de la session
  CHAUD_FORMATEUR
  /// Mise en pratique de l'apprenant, 60 jours après la fin
  FROID
  /// Campagne annuelle auprès des financeurs
  FINANCEUR
  /// Campagne annuelle auprès des formateurs
  SATISFACTION_FORMATEUR
}

model Questionnaire {
  id   String            @id @default(uuid(7))
  type TypeQuestionnaire

  /// Absente pour les campagnes annuelles (FINANCEUR, SATISFACTION_FORMATEUR)
  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Destinataire apprenant (POSITIONNEMENT, FROID)
  learnerId String?
  learner   Learner? @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// Destinataire formateur (CHAUD_FORMATEUR, SATISFACTION_FORMATEUR)
  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// Destinataire financeur (FINANCEUR)
  dossierFinancementId String?
  dossier               DossierFinancement? @relation(fields: [dossierFinancementId], references: [id], onDelete: Cascade)

  /// Empreinte SHA-256 du jeton contenu dans le lien
  jetonEmpreinte String   @unique
  expireAt       DateTime

  envoyeAt  DateTime?
  reponduAt DateTime?

  /// Réponses par identifiant de question (voir lib/questionnaires-questions.ts)
  reponses Json?
  /// Questions telles qu'elles ont été posées, figées à la réponse.
  questions Json?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([sessionId])
  @@index([reponduAt])
  @@map("questionnaires")
}

/// Contenu d'un questionnaire modifié depuis l'application (titre,
/// introduction, questions). Sans ligne pour un code, c'est le questionnaire
/// d'origine, écrit dans lib/questionnaires-questions.ts, qui s'applique :
/// revenir à l'origine revient à supprimer la ligne.
model ModeleQuestionnaire {
  id String @id @default(uuid(7))

  /// Type de questionnaire (POSITIONNEMENT, FROID…) ou SATISFACTION pour le
  /// questionnaire à chaud des apprenants, qui a sa propre table.
  code String @unique

  titre        String
  introduction String?
  questions    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modeles_questionnaire")
}

// ===========================================================================
// Factures et paiements (Phase 13)
// ===========================================================================

/// Qui règle la facture.
enum TypePayeur {
  ENTREPRISE
  OPCO
  APPRENANT
  /// Caisse des Dépôts, pour un dossier CPF (une facture par dossier)
  CAISSE_DES_DEPOTS
  FRANCE_TRAVAIL
  AUTRE
}

/// Le numéro légal d'une facture est attribué par Henrri, le logiciel de
/// facturation : l'application ne numérote jamais elle-même, pour éviter deux
/// séries de numéros concurrentes.
enum StatutFacture {
  /// Préparée dans Formalogy OS, pas encore émise dans Henrri
  A_EMETTRE
  /// Émise (numéro Henrri connu), en attente de paiement
  EMISE
  /// Entièrement réglée
  PAYEE
  ANNULEE
}

/// Comment la facture a été émise dans Henrri.
enum OrigineFacture {
  /// Numéro et PDF reportés à la main (Phase 13)
  MANUEL
  /// Créée, finalisée et récupérée automatiquement via l'API Henrri (Phase 16)
  AUTO
}

model Facture {
  id String @id @default(uuid(7))

  /// Numéro attribué par Henrri (ex. « F-2026-0042 »), absent tant que la
  /// facture n'est pas émise
  numero String? @unique
  /// Identifiant de la facture chez Henrri, une fois la connexion en place
  henrriId String? @unique

  objet String

  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  learnerId String?
  learner   Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)

  payeurType TypePayeur
  /// Nom affiché du payeur (raison sociale, nom de l'OPCO, apprenant…)
  payeurNom  String

  montantHT  Decimal @db.Decimal(10, 2)
  /// 0 pour les formations exonérées (article 261-4-4° du CGI), sinon 20
  tauxTva    Decimal @db.Decimal(4, 2)
  montantTTC Decimal @db.Decimal(10, 2)

  statut        StatutFacture @default(A_EMETTRE)
  origine       OrigineFacture @default(MANUEL)
  dateEmission  DateTime?
  dateEcheance  DateTime?
  annuleeAt     DateTime?

  /// PDF de la facture Henrri, rangé dans les documents
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("FactureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  paiements Paiement[]
  dossiers  DossierFinancement[]

  @@index([statut])
  @@index([sessionId])
  @@index([companyId])
  @@index([dateEcheance])
  @@map("factures")
}

enum MoyenPaiement {
  VIREMENT
  CHEQUE
  CARTE
  PRELEVEMENT
  ESPECES
  AUTRE
}

model Paiement {
  id String @id @default(uuid(7))

  factureId String
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Restrict)

  montant  Decimal       @db.Decimal(10, 2)
  /// Jour de l'encaissement, à minuit UTC
  date     DateTime
  moyen    MoyenPaiement
  reference String?
  notes    String?

  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("PaiementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([factureId])
  @@index([date])
  @@map("paiements")
}

// ===========================================================================
// Prises en charge OPCO et France Travail (Phase 14)
// ===========================================================================

enum TypeFinanceur {
  OPCO
  FRANCE_TRAVAIL
  CPF
  ENTREPRISE
  AUTRE
}

/// Aucun financeur n'expose d'API : le dossier se dépose sur leur portail et
/// se suit ici. Un financement saisi est considéré acquis dès sa création,
/// sans statut de demande à suivre.
model DossierFinancement {
  id String @id @default(uuid(7))

  /// Numéro du dossier chez le financeur
  reference String?

  financeurType TypeFinanceur
  /// Nom exact du financeur, ex. « OPCO EP », « France Travail — agence de Lille »
  financeurNom  String
  /// Adresse du contact chez le financeur, pour lui envoyer le questionnaire
  /// annuel notamment.
  email String?

  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  learnerId String?
  learner   Learner?         @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  montant Decimal? @db.Decimal(10, 2)
  /// Subrogation : le financeur paie directement l'organisme
  subrogation Boolean @default(true)

  dateDepot DateTime?

  /// Facture adressée au financeur, le cas échéant
  factureId String?
  facture   Facture? @relation(fields: [factureId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("DossierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  questionnaires Questionnaire[]

  @@index([sessionId])
  @@map("dossiers_financement")
}

// ===========================================================================
// Qualiopi (Phase 15)
// ===========================================================================

enum StatutIndicateur {
  A_FAIRE
  EN_COURS
  CONFORME
}

/// Indicateur du Référentiel national qualité, dans sa version V10 (décret
/// n° 2026-728 du 1er août 2026, applicable aux audits à partir du
/// 1er novembre 2026). Les intitulés sont ceux du décret et ne se modifient
/// pas depuis l'application ; seuls le suivi et les preuves sont saisis ici.
model IndicateurQualiopi {
  numero   Int    @id
  critere  Int
  intitule String

  /// Indicateur spécifique : ne concerne que certaines activités
  /// (certification professionnelle, apprentissage, alternance, AFEST).
  specifique Boolean @default(false)
  /// L'organisme déclare si l'indicateur le concerne.
  applicable Boolean @default(true)

  statut StatutIndicateur @default(A_FAIRE)
  /// Ce qui est en place, où le trouver, ce qui reste à faire.
  notes  String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("IndicateurUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  preuves Document[]
  actions ActionQualite[]

  @@map("indicateurs_qualiopi")
}

enum OrigineActionQualite {
  /// Écart relevé lors d'un audit
  AUDIT
  /// Constat interne
  INTERNE
  /// Réclamation d'un apprenant, d'une entreprise ou d'un financeur
  RECLAMATION
}

enum StatutActionQualite {
  A_FAIRE
  EN_COURS
  FAITE
}

/// Plan d'actions qualité : écarts d'audit, réclamations et améliorations,
/// avec leur suivi jusqu'à la clôture (indicateur 32).
model ActionQualite {
  id String @id @default(uuid(7))

  titre       String
  description String?
  origine     OrigineActionQualite @default(INTERNE)
  statut      StatutActionQualite  @default(A_FAIRE)

  numeroIndicateur Int?
  indicateur       IndicateurQualiopi? @relation(fields: [numeroIndicateur], references: [numero], onDelete: SetNull)

  responsable String?
  echeance    DateTime?
  faiteAt     DateTime?
  bilan       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("ActionQualiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([statut])
  @@index([numeroIndicateur])
  @@map("actions_qualite")
}
